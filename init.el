;;removes the startup messages.
(setq inhibit-startup-message t)

;; removes the menu-bar toogle to 1 to see it.
(menu-bar-mode -1)

;; removes the tool-bar toogle to 1 to see it.
(tool-bar-mode -1)

;;sets the numbering in emacs.
(global-display-line-numbers-mode 1)

;;remove scrolling.
(scroll-bar-mode -1)

;;finds the custom theme from themes directory
(add-to-list 'custom-theme-load-path "~/.emacs.d/themes")
;;loads the theme.
(load-theme 'stark t)

(require 'package)
(add-to-list 'package-archives '("melpa-stable","https://stable.melpa.org/packages/") t)
(custom-set-variables
 ;; custom-set-variables was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(custom-safe-themes ;; will be generated by emacs.
   '("id" default))
 '(package-selected-packages '(magit)))
